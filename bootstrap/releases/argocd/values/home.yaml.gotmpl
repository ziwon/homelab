global:
  domain: {{ requiredEnv "ARGOCD_HOSTNAME" }}

configs:
  params:
    server.insecure: "true"  
  rbac:
    defaultPolicy: 'role:readonly'
    policy.csv: |
      g, {{ requiredEnv "AUTHENTIK_ARGO_ADMIN_GROUP" }}, role:admin
    scopes: '[groups]'
  cm:
    oidc.config: |
      name: Authentik
      issuer: {{ requiredEnv "AUTHENTIK_ARGOCD_OIDC_ISSUER" }}
      clientID: {{ requiredEnv "AUTHENTIK_ARGOCD_OIDC_CLIENT_ID" }}
      clientSecret: $oidc.authentik.clientSecret
      requestedScopes: ["openid", "profile", "email", "groups"]
      requestedIDTokenClaims:
        groups:
          essential: true
  secret:
    createSecret: true
    extra:
      server.secretkey: {{ requiredEnv "ARGOCD_SERVER_SECRETKEY" }}  
      oidc.authentik.clientSecret: {{ requiredEnv "AUTHENTIK_ARGOCD_OIDC_CLIENT_SECRET" }}

controller:
  replicas: 1 
  metrics:
    enabled: true

server:
  replicas: 1 
  service:
    type: ClusterIP 
  extraArgs:
    - --insecure 
  ingress:
    enabled: false 

redis:
  resources:
    requests:
      cpu: 100m
      memory: 128Mi

repoServer:
  replicas: 1
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
  env:
    - name: HELM_REGISTRY_CONFIG
      value: /home/argocd/.config/helm/registry/config.json
  initContainers:
    - name: helm-registry-login
      image: quay.io/argoproj/argocd:v3.1.9
      command:
        - /bin/sh
        - -c
        - |
          set -eu
          umask 077
          mkdir -p /home/argocd/.config/helm/registry
          auth="$(printf '%s:%s' "$HARBOR_USERNAME" "$HARBOR_PASSWORD" | base64 | tr -d '\n')"
          printf '{"auths":{"harbor.home.lab":{"auth":"%s"}}}\n' "$auth" > /home/argocd/.config/helm/registry/config.json
      env:
        - name: HARBOR_USERNAME
          valueFrom:
            secretKeyRef:
              name: harbor-oci-restack
              key: username
        - name: HARBOR_PASSWORD
          valueFrom:
            secretKeyRef:
              name: harbor-oci-restack
              key: password
      volumeMounts:
        - name: helm-registry-config
          mountPath: /home/argocd/.config/helm/registry
  volumeMounts:
    - name: harbor-ca
      mountPath: /etc/ssl/certs/harbor-ca.crt
      subPath: harbor-ca.crt
      readOnly: true
    - name: helm-registry-config
      mountPath: /home/argocd/.config/helm/registry
  volumes:
    - name: harbor-ca
      secret:
        secretName: argocd-harbor-ca
        items:
          - key: HARBOR_HOME_LAB_CA_CRT
            path: harbor-ca.crt
    - name: helm-registry-config
      emptyDir: {}

extraObjects:
  - apiVersion: secrets.infisical.com/v1alpha1
    kind: InfisicalSecret
    metadata:
      name: argocd-harbor-ca
      namespace: argocd
      labels:
        app.kubernetes.io/managed-by: Helm
      annotations:
        meta.helm.sh/release-name: argocd
        meta.helm.sh/release-namespace: argocd
    spec:
      hostAPI: https://app.infisical.com/api
      authentication:
        universalAuth:
          secretsScope:
            projectSlug: home-lab
            envSlug: "hme"
            secretsPath: /argocd
          credentialsRef:
            secretName: infisical-secrets
            secretNamespace: infisical
      managedKubeSecretReferences:
        - secretName: argocd-harbor-ca
          secretNamespace: argocd
          creationPolicy: Owner

notifications:
  secret:
    create: true
    items:
      slack-token: {{ requiredEnv "ARGOCD_SLACK_TOKEN" }} 