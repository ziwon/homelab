global:
  domain: {{ requiredEnv "ARGOCD_HOSTNAME" }}

configs:
  params:
    server.insecure: "true"  
  rbac:
    defaultPolicy: 'role:readonly'
    policy.csv: |
      g, {{ requiredEnv "AUTHENTIK_ARGO_ADMIN_GROUP" }}, role:admin
    scopes: '[groups]'
  cm:
    oidc.config: |
      name: Authentik
      issuer: {{ requiredEnv "AUTHENTIK_OIDC_ISSUER" }}
      clientID: {{ requiredEnv "AUTHENTIK_OIDC_CLIENT_ID" }}
      clientSecret: $oidc.authentik.clientSecret
      requestedScopes: ["openid", "profile", "email", "groups"]
      requestedIDTokenClaims:
        groups:
          essential: true
  secret:
    createSecret: true
    extra:
      oidc.authentik.clientSecret: {{ requiredEnv "AUTHENTIK_OIDC_CLIENT_SECRET" }}

controller:
  replicas: 1 
  metrics:
    enabled: true

server:
  replicas: 1 
  service:
    type: ClusterIP 
  extraArgs:
    - --insecure 
  ingress:
    enabled: false 

redis:
  resources:
    requests:
      cpu: 100m
      memory: 128Mi

repoServer:
  replicas: 1
  resources:
    requests:
      cpu: 100m
      memory: 128Mi

notifications:
  enabled: false
