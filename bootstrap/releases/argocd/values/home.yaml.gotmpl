# ArgoCD 기본 설정 (단일 노드용)
global:
  domain: argocd.home.local  # K3s 기본 도메인
  image:
    repository: quay.io/argoproj/argocd
    tag: v2.12.4  # ArgoCD 앱 버전 (차트와 동기화 추천)

configs:
  params:
    server.insecure: "true"  # 개발용 (프로덕션: false + TLS)
  rbac:
    defaultPolicy: 'role:readonly'  # 기본 권한 (필요 시 조정)
  secret:
    createSecret: true

controller:
  replicas: 1  # 단일 노드: 1로 제한
  metrics:
    enabled: true

server:
  replicas: 1  # 단일 노드: 1로 제한
  service:
    type: ClusterIP  # 외부 접근 필요 시 LoadBalancer로 변경
  extraArgs:
    - --insecure  # 개발용
  ingress:
    enabled: false  # 필요 시 true + annotations 추가 (Cilium 호환)

redis:
  resources:
    requests:
      cpu: 100m
      memory: 128Mi

repoServer:
  replicas: 1
  resources:
    requests:
      cpu: 100m
      memory: 128Mi

notifications:
  enabled: false