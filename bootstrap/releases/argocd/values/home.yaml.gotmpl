global:
  domain: {{ requiredEnv "ARGOCD_HOSTNAME" }}

configs:
  params:
    server.insecure: "true"  
  rbac:
    defaultPolicy: 'role:readonly'
    policy.csv: |
      g, {{ requiredEnv "AUTHENTIK_ARGO_ADMIN_GROUP" }}, role:admin
    scopes: '[groups]'
  cm:
    oidc.config: |
      name: Authentik
      issuer: {{ requiredEnv "AUTHENTIK_ARGOCD_OIDC_ISSUER" }}
      clientID: {{ requiredEnv "AUTHENTIK_ARGOCD_OIDC_CLIENT_ID" }}
      clientSecret: $oidc.authentik.clientSecret
      requestedScopes: ["openid", "profile", "email", "groups"]
      requestedIDTokenClaims:
        groups:
          essential: true
  secret:
    createSecret: true
    extra:
      server.secretkey: {{ requiredEnv "ARGOCD_SERVER_SECRETKEY" }}  
      oidc.authentik.clientSecret: {{ requiredEnv "AUTHENTIK_ARGOCD_OIDC_CLIENT_SECRET" }}

controller:
  replicas: 1 
  metrics:
    enabled: true

server:
  replicas: 1 
  service:
    type: ClusterIP 
  extraArgs:
    - --insecure 
  ingress:
    enabled: false 

redis:
  resources:
    requests:
      cpu: 100m
      memory: 128Mi

repoServer:
  replicas: 1
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
  volumeMounts:
    - name: harbor-ca
      mountPath: /etc/ssl/certs/harbor-ca.crt
      subPath: harbor-ca.crt
      readOnly: true
  volumes:
    - name: harbor-ca
      secret:
        secretName: argocd-harbor-ca
        items:
          - key: HARBOR_HOME_LAB_CA_CRT
            path: harbor-ca.crt

extraObjects:
  - apiVersion: secrets.infisical.com/v1alpha1
    kind: InfisicalSecret
    metadata:
      name: argocd-harbor-ca
      namespace: argocd
    spec:
      hostAPI: https://app.infisical.com/api
      authentication:
        universalAuth:
          secretsScope:
            projectSlug: home-lab
            envSlug: "hme"
            secretsPath: /argocd
          credentialsRef:
            secretName: infisical-secrets
            secretNamespace: infisical
      managedKubeSecretReferences:
        - secretName: argocd-harbor-ca
          secretNamespace: argocd
          creationPolicy: Owner

notifications:
  secret:
    create: true
    items:
      slack-token: {{ requiredEnv "ARGOCD_SLACK_TOKEN" }} 