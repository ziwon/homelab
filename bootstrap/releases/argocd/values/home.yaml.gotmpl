global:
  domain: argocd.home.local
  image:
    repository: quay.io/argoproj/argocd
    tag: v2.12.4

configs:
  params:
    server.insecure: "true"  
  rbac:
    defaultPolicy: 'role:readonly'  
  secret:
    createSecret: true

controller:
  replicas: 1 
  metrics:
    enabled: true

server:
  replicas: 1 
  service:
    type: ClusterIP 
  extraArgs:
    - --insecure 
  ingress:
    enabled: false 

redis:
  resources:
    requests:
      cpu: 100m
      memory: 128Mi

repoServer:
  replicas: 1
  resources:
    requests:
      cpu: 100m
      memory: 128Mi

notifications:
  enabled: false