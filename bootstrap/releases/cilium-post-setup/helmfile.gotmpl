---
bases:
  - ../../bases/helmDefaults.yaml
  - ../../bases/envs.yaml.gotmpl

---
hooks:
  - events: ["prepare"]
    command: "bash"
    args:
      - "-c"
      - |
        set -e
        pushd ../../ >/dev/null 2>&1
        mkdir -p secrets
        DOMAIN="${DOMAIN_PRIVATE:-}"
        if [ -z "$DOMAIN" ]; then
          echo "Error: DOMAIN_PRIVATE environment variable is required" >&2
          exit 1
        fi
        if [ ! -f "secrets/${DOMAIN}.crt" ] || [ ! -f "secrets/${DOMAIN}.key" ]; then
          echo "Generating self-signed certificate for ${DOMAIN}..."
          openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
            -keyout "secrets/${DOMAIN}.key" \
            -out "secrets/${DOMAIN}.crt" \
            -subj "/CN=${DOMAIN}" \
            -addext "subjectAltName=DNS:${DOMAIN},DNS:*.${DOMAIN}"
        else
          echo "Certificate already exists, skipping generation."
        fi

        # Install secrtes in the infra namespace
        SECRET_NAME="tls-${DOMAIN_PRIVATE_SLUG:-${DOMAIN}}"
        if ! kubectl -n infra get secret "${SECRET_NAME}" >/dev/null 2>&1; then
          echo "Creating Kubernetes TLS secret '${SECRET_NAME}' in namespace 'infra'..."
          kubectl -n infra create secret tls "${SECRET_NAME}" \
          --cert="secrets/${DOMAIN}.crt" \
          --key="secrets/${DOMAIN}.key"
        else
          echo "Kubernetes TLS secret '${SECRET_NAME}' already exists, skipping creation."
        fi

        sudo cp secrets/${DOMAIN}.crt /usr/local/share/ca-certificates/${DOMAIN}.crt
        sudo update-ca-certificates
        popd >/dev/null

releases:
  - name: cilium-post-setup
    chart: ../../charts/raw
    installed: {{ .Values | getOrNil "cilium-post-setup.installed" | default false }}
    labels:
      layer: network
    hooks:
      - events: ["presync"]
        command: "bash"
        showlogs: true
        args:
          - "-c"
          - |
            set -e
            DOMAIN="${DOMAIN_PRIVATE}"
            SECRET_NAME="${TLS_SECRET_NAME_FOR_DOMAIN_PRIVATE}"
            KUBE_CONTEXT="{{`{{.Environment.KubeContext}}`}}"

            # Ensure namespace exists
            kubectl get namespace infra --context="$KUBE_CONTEXT" >/dev/null 2>&1 || \
              kubectl create namespace infra --context="$KUBE_CONTEXT"

            # Create TLS secret idempotently
            kubectl create secret tls "$SECRET_NAME" \
              --namespace=infra \
              --cert="../../secrets/${DOMAIN}.crt" \
              --key="../../secrets/${DOMAIN}.key" \
              --context="$KUBE_CONTEXT" \
              --dry-run=client -o yaml | kubectl apply -f -
      - events: ["postsync"]
        command: "bash"
        showlogs: true
        args:
          - "-c"
          - |
            set -e
            KUBE_CONTEXT="{{`{{.Environment.KubeContext}}`}}"
            echo "Restarting Cilium pods to apply Gateway API changes..."
            kubectl rollout restart deployment/cilium-operator -n kube-system --context="$KUBE_CONTEXT"
            kubectl rollout restart ds/cilium -n kube-system --context="$KUBE_CONTEXT"
      
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
