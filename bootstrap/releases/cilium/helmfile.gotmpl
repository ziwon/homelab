---
bases:
  - ../../bases/helmDefaults.yaml 
  - ../../bases/envs.yaml.gotmpl

---
repositories:
  - name: cilium
    url: https://helm.cilium.io/ 

releases:
  - name: cilium
    chart: cilium/cilium  
    installed: {{ .Values | get "cilium.installed" true }} 
    version: {{ .Values | get "cilium.chart_version" "1.18.2" }}
    namespace: kube-system
    createNamespace: true
    labels:
      layer: network
    hooks:
      - events: ["presync"]
        command: "../../hacks/install-gateway-api-crds.sh"
        args: ["{{ requiredEnv "K8S_GATEWAY_API_VERSION" }}"]
        showlogs: true
    values:
      - default.yaml
      - values/{{ .Environment.Name }}.yaml.gotmpl
