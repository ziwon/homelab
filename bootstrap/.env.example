ENV=home # aws, aure, gcp, idc

# ========================
# K3s Cluster Configuration
# ========================
INSTALL_K3S_CHANNEL=stable
K8S_TLS_SANS=
K8S_GATEWAY_API_VERSION=
CLUSTER_CIDR=
SERVICE_CIDR=
KUBECONFIG=

# ========================
# Cilium CNI Configuration
# ========================
CNI_BIN_PATH=
CNI_CONF_PATH=

# ========================
# Infra Setup with Cilium
# ========================
DOMAIN_PRIVATE=
DOMAIN_PUBLIC=
L2_BRIDGE_INTERFACE=
L2_ANNOUNCEMENT_CIDR_GW=
L2_ANNOUNCEMENT_CIDR_DNS=
IP_ADDR_GW=
IP_ADDR_DNS=
IP_ADDR_COREDNS=
TLS_SECRET_NAME_FOR_DOMAIN_PRIVATE=
TLS_SECRET_NAME_FOR_DOMAIN_PUBLIC=

# ========================
# NVIDIA GPU Operator Configuration
# ========================
NVIDIA_DRIVER_VERSION="580.95.05" 
NVIDIA_GPU_OPERATOR_VERSION="v25.3.4"
NVIDIA_CONTAINER_TOOLKIT_VERSION="v1.18.0"

# ========================
# Infisical
# ========================
INFISICAL_API=https://app.infisical.com/api
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_SLUG=home-lab
